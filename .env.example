# Copy this file to .env for local Docker Compose development only.
DJANGO_SECRET_KEY=replace-with-a-long-unique-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=worknoon_refunds
POSTGRES_USER=worknoon
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Optional AI configuration. Do not add a real key to source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Bounded provider deadline. The default is 20 seconds when omitted.
OPENAI_TIMEOUT_SECONDS=20
